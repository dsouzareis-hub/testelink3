# Arquivos enviados pelos usuários (evidências e logo) não vão para o repositório
uploads/evidences/*
uploads/logo/*
!uploads/.htaccess
!uploads/evidences/.gitkeep
# Fontes proprietárias copiadas pelo usuário para o PDF
assets/fonts/*.ttf
# Sistema/editor
.DS_Store
Thumbs.db
*.log
# Lixeira (fotos de itens excluídos) e backups do banco: dados reais, nunca vão para o repositório
uploads/trash/*
backups/
